# ── fishing-app production environment profile (.env.production) ──
# Isolated production pointers ONLY. Zero staging/development keys may live
# here: local/staging values stay in .env / EAS `development` + `preview`
# environments. Real secrets are injected by `eas env:push --environment
# production` (EAS-managed); this file ships only the key SHAPE so
# `expo config` + EAS validation resolve deterministically.
#
# Client bundle (EXPO_PUBLIC_*: inlined into the JS bundle):
EXPO_PUBLIC_SUPABASE_URL=https://your-production-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_production_publishable_key_here
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_production_publishable_key_here
EXPO_PUBLIC_STRIPE_PRICE_MONTHLY=price_your_production_monthly_price_id
EXPO_PUBLIC_STRIPE_PRICE_YEARLY=price_your_production_yearly_price_id
#
# Task aliases (exact variable names requested by the release gate):
SUPABASE_URL=https://your-production-project.supabase.co
SUPABASE_ANON_KEY=your_production_anon_key_here
MAP_TILE_PROVIDER_URI=https://tile.openstreetmap.org/{z}/{x}/{y}.png
#
# Native build credential (EAS secret on cloud builds; blank = omitted):
GOOGLE_MAPS_ANDROID_API_KEY=
